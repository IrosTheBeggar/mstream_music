<?xml version="1.0" encoding="utf-8"?>
<!-- Two cells and up: a bigger cover on the left; text above the buttons on
     the right. Same ids as the compact layout — the renderer fills both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/npw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/npw_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/npw_art"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/npw_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/npw_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/npw_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="mStream"
                    android:textColor="@color/npw_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/npw_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/npw_label"
                    android:textColor="@color/npw_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/npw_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/npw_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/npw_nothing_playing"
                    android:textColor="@color/npw_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/npw_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/npw_open_app"
                    android:textColor="@color/npw_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/npw_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/npw_previous"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/npw_previous"
                android:padding="9dp"
                android:src="@drawable/npw_ic_previous" />

            <ImageView
                android:id="@+id/npw_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/npw_play"
                android:padding="6dp"
                android:src="@drawable/npw_ic_play" />

            <ImageView
                android:id="@+id/npw_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/npw_next"
                android:padding="9dp"
                android:src="@drawable/npw_ic_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
