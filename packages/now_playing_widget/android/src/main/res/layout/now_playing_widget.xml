<?xml version="1.0" encoding="utf-8"?>
<!-- Compact row (4x1): cover, two lines, three buttons. Only RemoteViews-safe
     views. The default texts are what the widget picker's preview shows
     (previewLayout points here); every real render overwrites them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/npw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/npw_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/npw_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/npw_art_placeholder" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/npw_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/npw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="mStream"
                android:textColor="@color/npw_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/npw_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/npw_label"
                android:textColor="@color/npw_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/npw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/npw_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/npw_nothing_playing"
                android:textColor="@color/npw_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/npw_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/npw_open_app"
                android:textColor="@color/npw_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/npw_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/npw_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/npw_previous"
            android:padding="8dp"
            android:src="@drawable/npw_ic_previous" />

        <ImageView
            android:id="@+id/npw_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/npw_play"
            android:padding="6dp"
            android:src="@drawable/npw_ic_play" />

        <ImageView
            android:id="@+id/npw_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/npw_next"
            android:padding="8dp"
            android:src="@drawable/npw_ic_next" />
    </LinearLayout>
</LinearLayout>
