<?xml version="1.0" encoding="utf-8"?>
<!-- Two cells square: the cover fills the card (rounded at the card's radius
     by the renderer, clipped by the outline on Android 12+ as well), a scrim
     at the bottom carries the text, play/pause and next in light glyphs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/npw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/npw_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/npw_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/npw_art_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/npw_tile_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/npw_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/npw_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="mStream"
                    android:textColor="@color/npw_tile_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/npw_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/npw_label"
                    android:textColor="@color/npw_tile_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/npw_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/npw_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/npw_nothing_playing"
                    android:textColor="@color/npw_tile_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/npw_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/npw_open_app"
                    android:textColor="@color/npw_tile_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/npw_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/npw_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/npw_play"
                android:padding="6dp"
                android:src="@drawable/npw_ic_play" />

            <ImageView
                android:id="@+id/npw_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/npw_next"
                android:padding="7dp"
                android:src="@drawable/npw_ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
